{
  "name": "of-dragons-deep",
  "version": "1.0.0",
  "private": true,
  "description": "Web app for tracking fish caught in Final Fantasy XIV, to help with the big fishing achievements.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/update-data.mjs && vite build",
    "build:app": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "vite build && playwright test",
    "data": "node scripts/update-data.mjs",
    "fetch:icons": "node scripts/fetch-icons.mjs && node scripts/webp-sheets.mjs",
    "app-icons": "node scripts/app-icons.mjs"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.63.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.12",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "jsdom": "^31.0.1",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  }
}
