{
  "name": "of-dragons-deep",
  "version": "0.1.0",
  "private": true,
  "description": "Web app for tracking fish caught in Final Fantasy XIV, to help with the big fishing achievements.",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "playwright": "1.63.0"
  },
  "scripts": {
    "dev": "node scripts/serve.mjs",
    "fetch-data": "node scripts/fetch-fish-data.mjs",
    "fetch-icons": "node scripts/fetch-icons.mjs && node scripts/webp-sheets.mjs",
    "fetch-baits": "node scripts/fetch-bait-data.mjs",
    "build": "node scripts/build.mjs",
    "test": "node tests/run.mjs",
    "test:record": "node tests/fixtures/record.mjs"
  }
}
